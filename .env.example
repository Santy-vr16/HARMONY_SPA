# Copia este archivo como ".env" y ajusta los valores. NO subas .env a Git.
APP_NAME=Harmony Spa API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# MySQL: usuario:contraseña@servidor:puerto/base_de_datos
DATABASE_URL=mysql+pymysql://root:TU_PASSWORD@localhost:3306/harmony_spa

# Genera la clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=PEGA_AQUI_LA_CLAVE_GENERADA_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
SESSION_INACTIVITY_MINUTES=30
